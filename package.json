    "review:annual": "tsx scripts/review-annual-topics.ts",
    "apply:annual": "tsx scripts/apply-annual-topics.ts",
    "validate:annual-artifacts": "tsx scripts/validate-annual-classifier-artifacts.ts",
    "validate:annual-publication": "tsx scripts/validate-annual-topic-publication.ts",
    "test:annual-classifier": "node --test scripts/__tests__/annual-classifier.test.ts scripts/__tests__/annual-topic-publication.test.ts",
    "sync:calendar": "tsx scripts/sync-calendar.ts",
    "validate:booklets": "tsx scripts/sync-osym-booklets.ts --validate-only",
    "check:booklets": "tsx scripts/sync-osym-booklets.ts --check",
    "sync:booklets": "tsx scripts/sync-osym-booklets.ts --write",
    "discover:booklets": "tsx scripts/discover-osym-booklets.ts",
    "validate:ogm-topics": "tsx scripts/sync-ogm-topic-books.ts --validate-only",
    "audit:ogm-topics": "tsx scripts/sync-ogm-topic-books.ts --audit",
    "check:ogm-new-editions": "tsx scripts/check-ogm-new-editions.ts",
    "build:ogm-topic-groups": "tsx scripts/build-topic-group-statistics.ts",
    "build:topics-official": "tsx scripts/build-topics-from-official.ts",
    "fetch:news": "tsx scripts/fetch-news.ts",
    "check": "npm run validate:pack && npm run validate:annual-publication && npm run validate:booklets && npm run validate:ogm-topics && npm run typecheck && npm run lint && npm test"
  },
  "private": true
}
