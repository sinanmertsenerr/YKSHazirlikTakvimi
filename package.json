    "web": "expo start --web",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint --max-warnings 0",
    "doctor": "expo-doctor",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit && npm run test:content",
    "test:unit": "jest --runInBand",
    "test:content": "node --test scripts/__tests__/*.test.ts",
    "test:coverage": "jest --coverage --runInBand && npm run test:content",
