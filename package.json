    "sign:pack": "tsx scripts/sign-pack.ts",
    "verify:pack-signature": "tsx scripts/verify-pack-signature.ts",
    "check:pack-change": "tsx scripts/check-pack-content-change.ts",
    "sync:pack-version": "tsx scripts/sync-pack-version.ts",
    "validate:cloudflare": "wrangler deploy --dry-run --config infra/cloudflare/wrangler.toml --outdir tmp/cloudflare-dry-run",
